# Use sandbox Stripe credentials during development.
# FastAPI reads the first four values when registering the retainer module.
# Next.js also needs the server-only Stripe key for the seller portal.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RETAINER_PRICE_ID=
# Set the same strong random signing secret in FastAPI and Next.js.
WIELE_INTERNAL_API_SECRET=

# Next.js server-only proxy origin. The proxy appends /api/retainer/{action}.
WIELE_BACKEND_URL=http://127.0.0.1:8000
RETAINER_LEDGER_DB_PATH=./data/retainer_ledger.db

# Optional FastAPI settings used by the supplied implementation.
NEXT_PUBLIC_APP_URL=http://localhost:3000
CLOSE_API_KEY=
WIELE_ALGO_DISPATCH_URL=
